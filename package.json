{
  "name": "dev-skills",
  "version": "1.0.0",
  "description": "임패커스 Claude Code skill 모노레포. npx 한 줄로 ~/.claude/skills/ 에 설치.",
  "type": "module",
  "bin": {
    "dev-skills": "./bin/cli.mjs"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate": "npm run validate:dev-standards:skill",
    "validate:dev-standards:internal-accuracy": "node skills/impakers-dev-standards/scripts/validate-internal-accuracy.mjs",
    "validate:dev-standards:skill": "node skills/impakers-dev-standards/scripts/validate-dev-standards.mjs --no-target --skill skills/impakers-dev-standards/SKILL.md --slot-data skills/impakers-dev-standards/scripts/dev-standards.contract.example.json",
    "validate:dev-standards": "node skills/impakers-dev-standards/scripts/validate-dev-standards.mjs --allow-missing --slot-data skills/impakers-dev-standards/scripts/dev-standards.contract.example.json",
    "validate:dev-standards:strict": "node skills/impakers-dev-standards/scripts/validate-dev-standards.mjs --slot-data skills/impakers-dev-standards/scripts/dev-standards.contract.example.json"
  },
  "files": [
    "bin/",
    "skills/",
    "README.md"
  ],
  "keywords": [
    "claude-code",
    "claude-skill",
    "impakers",
    "shadcn",
    "ui-rules",
    "design-system"
  ],
  "author": "IMPAKERS",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/impakers/dev-skills.git"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.19.25",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3"
  }
}
